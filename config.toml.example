# Syncronizer configuration — copy to  <DATA_DIR>/config/config.toml
# On Windows the installer writes this to  C:\ProgramData\Syncronizer\config\config.toml
# For local dev:  $SYNCRONIZER_DATA_DIR/config/config.toml  (e.g. ./data/config/config.toml)
#
# This file holds SECRETS (Firebird path/credentials, API token). It lives OUTSIDE the
# git working tree and is .gitignored — it must NEVER be committed to the public repo.
# Any value can also be supplied/overridden by a SYNC_<UPPER_FIELD> environment variable.

[firebird]
# REQUIRED: absolute path to the local Firebird 2.5 .fdb (raw path; do not URL-encode).
path = "C:\\data\\app.fdb"
host = "localhost"
port = 3050
user = "SYSDBA"
password = "masterkey"        # prefer the SYNC_FIREBIRD_PASSWORD env var over plaintext here
charset = "UTF8"              # use "NONE" or "WIN1252" for legacy databases
connect_timeout = 10.0

[api]
base_url = "https://api.example.com"
key = ""                      # API KEY sent on every request (prefer SYNC_API_KEY env)
key_header = "X-API-Key"      # header name your API expects (e.g. "apikey", "X-Api-Key")
token = ""                    # optional Bearer token alternative (prefer SYNC_API_TOKEN)
timeout = 30
max_retries = 3

[runtime]
cycle_minutes = 10
batch_size = 500
misfire_grace_time = 300
run_on_start = true
# Janela de execução: a sincronização (leitura do Firebird + envio à API) só roda
# dentro da janela, em HORÁRIO LOCAL. Fora dela o backlog fica durável no control.db
# e escoa a partir do início da janela. O fuso é por offset fixo (sem tzdata): o Brasil
# não tem horário de verão, então -3 = America/Sao_Paulo.
tz_offset_hours = -3
etl_window_enabled = true
etl_window_start_hour = 7      # inclusivo (>=)
etl_window_end_hour = 19       # exclusivo (<): roda 07:00–18:59, para às 19:00

[update]
auto_update = true
branch = "main"               # tracked channel; consider a protected "release" branch in production
update_minutes = 30
repo_url = "https://github.com/azimute-tech/syncronizer.git"
allow_hard_reset = false      # opt-in recovery from a force-pushed/rebased upstream
max_boot_attempts = 3
boot_grace_minutes = 5

[paths]
# Installer-written absolute paths. Leave unset in dev (derived from the data dir).
# git_exe = "C:\\Program Files\\Syncronizer\\runtime\\git\\cmd\\git.exe"
# nssm_exe = "C:\\Program Files\\Syncronizer\\runtime\\nssm\\nssm.exe"
# repo_dir = "C:\\ProgramData\\Syncronizer\\repo"
# venv_dir = "C:\\ProgramData\\Syncronizer\\venv"

[logging]
level = "INFO"
max_bytes = 10485760          # 10 MB
backup_count = 7

[backup]
# Backup noturno do Firebird: gbak (.fbk) -> gzip -> upload direto pro GCS via signed URL.
# Reusa [api] (endpoints upload-url/confirm) e [firebird] (credenciais do gbak); SEM segredos novos.
enabled = false
# Horário do backup em HORÁRIO LOCAL (mesmo offset de [runtime].tz_offset_hours).
# Roda 1x/dia; se a internet cair às 20:00, um catch-up (a cada 30min) retenta no mesmo
# dia até concluir — no máximo 1 backup OK por dia.
hour = 20
minute = 0
# Caminho do gbak.exe. Vazio = auto-descoberto em C:\Program Files\Firebird\Firebird_2_5\bin
# (e variante Program Files (x86)).
# gbak_path = "C:\\Program Files\\Firebird\\Firebird_2_5\\bin\\gbak.exe"
gbak_use_service = true        # conecta via "localhost/<port>:<fdb>" (usa o Firebird Service)
db_alias = "agrodb"            # prefixo do nome do arquivo: <db_alias>_<YYYY-MM-DD>.fbk
compression = "gzip"           # "gzip" (nível 9) ou "xz" (lzma; menor, mais lento)
# temp_dir = "C:\\ProgramData\\Syncronizer\\state\\backup"   # vazio = state/backup
upload_read_timeout = 600      # timeout de leitura do PUT em segundos (uploads lentos)
max_retries = 3                # tentativas do triplete upload-url -> PUT -> confirm
min_free_disk_multiplier = 2.5 # exige disco livre >= mult * tamanho do .fdb antes do gbak

[indicadores]
# Raspagem noturna do Indicador do Boi Gordo CEPEA/B3 (CEPEA-ESALQ/USP, à vista, base SP,
# R$/@) e envio à API do AgroDB (preço default da simulação de venda). Reusa [api]
# (POST /api/integracoes/indicadores com o mesmo auth); SEM segredos novos.
# TODAS as fazendas enviam o mesmo indicador do dia — a API faz upsert por
# (indicador, data), então re-envio é sucesso normal (idempotente de ponta a ponta).
enabled = false
# Horário em HORÁRIO LOCAL (mesmo offset de [runtime].tz_offset_hours). Roda 1x/dia;
# se falhar (internet fora), um catch-up (a cada 30min) retenta no mesmo dia até
# concluir — no máximo 1 sucesso/dia por instância.
hour = 20
minute = 30
